{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.netlify/functions/:name",
      "destination": "/api/:name"
    }
  ],
  "functions": {
    "api/claude.ts": {
      "maxDuration": 120
    }
  }
}
